# Absolute host path only. Keep the actual key outside the repository.
TOTPVault_MASTER_KEY_HOST_PATH=/etc/totpvault/master.key

# Keep false for loopback HTTP. Set true only when served through HTTPS.
TOTPVault_UI_SECURE_COOKIE=false

# Extend only when intentionally publishing behind a trusted reverse proxy.
TOTPVault_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
